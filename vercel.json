{
  "framework": "nextjs",
  "regions": ["sin1"],
  "functions": {
    "app/api/webhook/bank/route.ts": { "maxDuration": 30 },
    "app/api/cron/*/route.ts": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron/payment-reminder", "schedule": "*/30 * * * *" },
    { "path": "/api/cron/expire-orders", "schedule": "*/15 * * * *" },
    { "path": "/api/cron/legal-review-reminder", "schedule": "0 8 * * 1" },
    { "path": "/api/cron/monthly-report", "schedule": "0 7 1 * *" },
    { "path": "/api/cron/progress-digest", "schedule": "0 19 * * 0" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/api/webhook/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
